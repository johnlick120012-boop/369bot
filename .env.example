# Discord Bot Configuration
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
COMMAND_PREFIX=!

# Comma-separated KOL tracker channel IDs (alerts go to ALL)
KOL_TRACKER_CHANNEL_ID=CHANNEL_ID_1,CHANNEL_ID_2

# Solana Helius RPC Keys
HELIUS_API_KEY=YOUR_HELIUS_KEY_1
HELIUS_API_KEY_2=YOUR_HELIUS_KEY_2

# Custom Tracker Channel (leave empty = all channels allowed, or comma-separated IDs)
CUSTOM_TRACKER_CHANNEL_ID=

# Channel where /ca command is restricted to (leave empty = all channels)
CA_CHANNEL_ID=YOUR_CA_CHANNEL_ID

# Category IDs where commands are restricted (leave empty = all categories)
ALLOWED_CATEGORY_IDS=YOUR_CATEGORY_ID

# Supabase Configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Solana Premium Payment Address
SOLANA_PAYMENT_ADDRESS=YOUR_SOLANA_WALLET_ADDRESS

# Fund Split Configuration
SOLANA_PRIVATE_KEY=YOUR_SOLANA_PRIVATE_KEY
SPLIT_ADDRESS_A=YOUR_SPLIT_WALLET_A
SPLIT_ADDRESS_B=YOUR_SPLIT_WALLET_B
